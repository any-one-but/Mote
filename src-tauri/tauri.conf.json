{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mote",
  "version": "0.6.0",
  "identifier": "com.anyonebut.mote",
  "build": {
    "beforeDevCommand": "npm run desktop:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mote",
        "width": 380,
        "height": 420,
        "minWidth": 220,
        "minHeight": 240,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#e4ddd2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/mote-senses"
    ]
  }
}
